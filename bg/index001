<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blogger Image HTML Generator & Link Converter</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f4f6f9; color: #333; padding: 20px; }
    .container { max-width: 850px; margin: 0 auto; background: #fff; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); }
    h1 { font-size: 22px; color: #1a73e8; margin-bottom: 20px; text-align: center; font-weight: 700; }
    
    .tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid #e0e0e0; flex-wrap: wrap; }
    .tab-btn { padding: 12px 18px; border: none; background: none; font-size: 14px; font-weight: 600; color: #666; cursor: pointer; border-bottom: 3px solid transparent; transition: all 0.2s; }
    .tab-btn.active { color: #1a73e8; border-bottom-color: #1a73e8; }
    
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    
    label { display: block; font-weight: 600; margin-bottom: 8px; font-size: 14px; color: #444; }
    textarea, input[type="text"] { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; font-family: monospace; outline: none; transition: border 0.2s; }
    textarea:focus, input[type="text"]:focus { border-color: #1a73e8; }
    textarea { height: 160px; resize: vertical; }
    
    .btn { background: #1a73e8; color: white; border: none; padding: 12px 24px; font-size: 14px; font-weight: 600; border-radius: 8px; cursor: pointer; margin-top: 15px; width: 100%; transition: background 0.2s; }
    .btn:hover { background: #1557b0; }
    .btn-copy { background: #34a853; margin-top: 10px; }
    .btn-copy:hover { background: #2d8e47; }
    
    .output-section { margin-top: 25px; padding-top: 20px; border-top: 1px solid #eee; }
    .status { margin-top: 10px; font-size: 13px; font-weight: 600; word-break: break-word; line-height: 1.4; }
    .status.error { color: #d93025; }
    .status.success { color: #188038; }
  </style>
</head>
<body>

<div class="container">
  <h1>Blogger Image & Drive Link Converter</h1>

  <!-- Navigation Tabs -->
  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('tab-foto', 0)">1. Per Foto (HTML Blogger)</button>
    <button class="tab-btn" onclick="switchTab('tab-folder', 1)">2. Folder Drive (HTML Blogger)</button>
    <button class="tab-btn" onclick="switchTab('tab-direct', 2)">3. Convert Direct Link Only</button>
  </div>

  <!-- TAB 1: PER FOTO (HTML BLOGGER) -->
  <div id="tab-foto" class="tab-content active">
    <label for="linksInput">Tempel Link Google Drive Per Foto (Satu link per baris):</label>
    <textarea id="linksInput" placeholder="https://drive.google.com/file/d/1-XvzfC2.../view&#10;https://drive.google.com/file/d/1Cp7BtSu.../view"></textarea>
    <button class="btn" onclick="generateFromLinks()">Generate HTML Blogger</button>
  </div>

  <!-- TAB 2: LINK FOLDER (HTML BLOGGER) -->
  <div id="tab-folder" class="tab-content">
    <label for="folderInput">Link Folder Google Drive:</label>
    <input type="text" id="folderInput" placeholder="https://drive.google.com/drive/folders/1UYPUt6Byt94JGDrf8FMza9QQCwKtIPsg">
    
    <button class="btn" onclick="generateFromFolder()">Fetch Folder & Generate HTML</button>
  </div>

  <!-- TAB 3: DIRECT LINK ONLY (USERCONTENT TANPA HTML) -->
  <div id="tab-direct" class="tab-content">
    <label for="directInput">Tempel Link Google Drive (Satu link per baris):</label>
    <textarea id="directInput" placeholder="https://drive.google.com/file/d/1-XvzfC2.../view&#10;https://drive.google.com/file/d/1Cp7BtSu.../view"></textarea>
    <button class="btn" onclick="generateDirectLinks()">Convert ke Direct Link Usercontent</button>
  </div>

  <!-- STATUS & OUTPUT SECTION -->
  <div class="output-section">
    <label for="outputHtml">Hasil Konversi / Output:</label>
    <textarea id="outputHtml" readonly placeholder="Hasil akan muncul di sini..."></textarea>
    <div id="statusMsg" class="status"></div>
    <button class="btn btn-copy" onclick="copyOutput()">Salin Hasil</button>
  </div>
</div>

<script>
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbz_3ETP75Keg2qWz8Xx-9bJSva-gWs_wh7dIfkpNFu2XV6Cn93jcHPBgf764U8jeillmg/exec";

  function switchTab(tabId, index) {
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
    
    document.querySelectorAll('.tab-btn')[index].classList.add('active');
    document.getElementById(tabId).classList.add('active');
    setStatus('');
  }

  function setStatus(msg, isError = false) {
    const el = document.getElementById('statusMsg');
    el.innerText = msg;
    el.className = 'status ' + (isError ? 'error' : 'success');
  }

  function buildBloggerHtml(fileId) {
    return `<div class="separator" style="clear: both; text-align: center;">\n` +
           `  <a href="https://lh3.googleusercontent.com/d/${fileId}=s0" style="margin-left: 1em; margin-right: 1em;">\n` +
           `    <img border="0" src="https://lh3.googleusercontent.com/d/${fileId}=s1600" style="max-width: 100%; height: auto;" />\n` +
           `  </a>\n` +
           `</div>\n<br />\n\n`;
  }

  // Mode 1: Per Foto -> HTML Blogger
  function generateFromLinks() {
    const text = document.getElementById('linksInput').value;
    const lines = text.split('\n');
    let html = '';
    let count = 0;

    lines.forEach(line => {
      const match = line.match(/\/d\/([a-zA-Z0-9_-]+)/);
      if (match && match[1]) {
        html += buildBloggerHtml(match[1]);
        count++;
      }
    });

    document.getElementById('outputHtml').value = html;
    if (count > 0) {
      setStatus(`Berhasil me-generate ${count} HTML gambar Blogger.`);
    } else {
      setStatus('Tidak ditemukan Link File Google Drive yang valid.', true);
    }
  }

  // Mode 2: Link Folder -> HTML Blogger
  async function generateFromFolder() {
    const folderUrl = document.getElementById('folderInput').value.trim();
    const folderMatch = folderUrl.match(/folders\/([a-zA-Z0-9_-]+)/);
    const folderId = folderMatch ? folderMatch[1] : folderUrl;

    if (!folderId) {
      setStatus('Link Folder Drive tidak valid.', true);
      return;
    }

    setStatus('Mengambil data foto dari folder...');

    try {
      const response = await fetch(`${SCRIPT_URL}?folderId=${encodeURIComponent(folderId)}`, {
        method: 'GET',
        redirect: 'follow'
      });

      const data = await response.json();

      if (data.error) {
        setStatus('Error Apps Script: ' + data.error, true);
        return;
      }

      if (!data.files || data.files.length === 0) {
        setStatus('Tidak ada file gambar ditemukan di dalam folder tersebut.', true);
        return;
      }

      let html = '';
      data.files.forEach(file => {
        html += buildBloggerHtml(file.id);
      });

      document.getElementById('outputHtml').value = html;
      setStatus(`Berhasil mengambil ${data.files.length} gambar (urut berdasarkan nama file).`);
    } catch (err) {
      console.error(err);
      setStatus('Gagal terhubung ke Apps Script.', true);
    }
  }

  // Mode 3: Convert Direct Link Usercontent Saja (Tanpa HTML Blogger)
  function generateDirectLinks() {
    const text = document.getElementById('directInput').value;
    const lines = text.split('\n');
    let result = '';
    let count = 0;

    lines.forEach(line => {
      const match = line.match(/\/d\/([a-zA-Z0-9_-]+)/);
      if (match && match[1]) {
        result += `https://lh3.googleusercontent.com/d/${match[1]}=s0\n`;
        count++;
      }
    });

    document.getElementById('outputHtml').value = result.trim();
    if (count > 0) {
      setStatus(`Berhasil mengonversi ${count} link menjadi direct URL usercontent.`);
    } else {
      setStatus('Tidak ditemukan Link File Google Drive yang valid.', true);
    }
  }

  function copyOutput() {
    const output = document.getElementById('outputHtml');
    if (!output.value) {
      setStatus('Tidak ada data untuk disalin!', true);
      return;
    }
    output.select();
    document.execCommand('copy');
    setStatus('Hasil berhasil disalin ke clipboard!');
  }
</script>

</body>
</html>
